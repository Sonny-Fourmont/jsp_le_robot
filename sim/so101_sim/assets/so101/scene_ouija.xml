<mujoco model="tek5_ouija">
    <!-- Phase 2 scene: Ouija board in front of the robot, a pushable planchette (puck),
         an external camera above the board. The pick & place cube and drop box are kept
         (parked away) so that SO101Sim keeps working unchanged.
         Board texture + letter layout: ouija/make_board.py -> ouija_board.png, ouija_layout.json -->
    <include file="so101_tek5.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="720" />
    </visual>

    <default>
        <default class="pickup_visual">
            <geom type="mesh" mesh="pickup_object" material="red" contype="0" conaffinity="0"
                group="2" density="0" />
        </default>
        <default class="pickup_collision">
            <geom type="mesh" mesh="pickup_object_collision" group="3" mass="0.005"
                friction="1.0 0.005 0.0001" />
        </default>
    </default>

    <asset>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
            rgb1="0.25 0.25 0.28" rgb2="0.18 0.18 0.20" markrgb="0.6 0.6 0.6"
            width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true"
            texrepeat="5 5" reflectance="0.1" />
        <material name="red" rgba="0.80 0.05 0.22 1" specular="0.3" shininess="0.3" />
        <material name="box_mat" rgba="0.35 0.20 0.12 1" />
        <mesh name="pickup_object" file="hollow_cube_rhombus_50mm.stl" scale="0.001 0.001 0.001" />
        <mesh name="pickup_object_collision" file="pickup_object_collision_octant.stl"
            scale="0.001 0.001 0.001" />

        <texture type="2d" name="ouija_board" file="ouija/ouija_board.png" />
        <material name="ouija_board" texture="ouija_board" texuniform="false" specular="0.1" shininess="0.1" />
        <material name="planchette_mat" rgba="0.10 0.35 0.95 1" />
    </asset>

    <worldbody>
        <light pos="0 0 2.5" dir="0 0 -1" directional="true" />
        <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Ouija board: 30 x 50 cm, 4 mm thick, centre at x = 0.235 (see make_board.py) -->
        <body name="ouija_board" pos="0.235 0 0.002">
            <geom name="ouija_board" type="box" size="0.15 0.25 0.002" material="ouija_board"
                friction="0.5 0.005 0.0001" />
        </body>

        <!-- Planchette: a light ring (outer r = 2.1 cm, hole r = 1.1 cm, h = 1.5 cm) like the
             window of a real planchette. The gripper tip goes into the hole and drags it in any
             direction. 8 boxes (MuJoCo collisions need convex pieces). Starts on FIN. -->
        <body name="planchette" pos="0.18 0 0.0115">
            <freejoint name="planchette_free" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="0.0160 0.0000 0" axisangle="0 0 1 0.0000" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="0.0113 0.0113 0" axisangle="0 0 1 0.7854" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="0.0000 0.0160 0" axisangle="0 0 1 1.5708" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="-0.0113 0.0113 0" axisangle="0 0 1 2.3562" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="-0.0160 0.0000 0" axisangle="0 0 1 3.1416" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="-0.0113 -0.0113 0" axisangle="0 0 1 3.9270" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="-0.0000 -0.0160 0" axisangle="0 0 1 4.7124" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
            <geom type="box" size="0.0050 0.0072 0.0075" pos="0.0113 -0.0113 0" axisangle="0 0 1 5.4978" mass="0.004" material="planchette_mat" friction="0.4 0.005 0.0001" />
        </body>

        <!-- Phase 1 objects, parked out of the way -->
        <body name="pickup_object" pos="-0.30 0.35 0.025">
            <freejoint name="pickup_object_free" />
            <geom name="pickup_object_visual" class="pickup_visual" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>
        <body name="drop_box" pos="-0.30 -0.35 0.0">
            <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 0.05 0.025" material="box_mat" />
            <geom type="box" size="0.05 0.002 0.025" pos="0 -0.05 0.025" material="box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="0.05 0 0.025" material="box_mat" />
            <geom type="box" size="0.002 0.05 0.025" pos="-0.05 0 0.025" material="box_mat" />
        </body>

        <!-- External camera: above the far edge of the board, looking down at the board centre
             (20 deg from vertical, towards the robot) so that the arm hides the planchette as
             little as possible. Image "up" = world +x (far edge), image right = world -y. -->
        <camera name="external_cam" pos="0.565 0 0.90" xyaxes="0 -1 0 0.9389 0 -0.3443" fovy="34" />
    </worldbody>
</mujoco>

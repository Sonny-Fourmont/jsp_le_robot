# Copy to docker/.env and edit: cp .env.example .env

# ROS 2 domain (0-101). Use a distinct value per group sharing a machine/network.
ROS_DOMAIN_ID=42

# Set to true for simulation, false for real hardware
USE_SIM=true

# Simulation scene (file in sim/so101_sim/assets/so101/). Empty = pick & place scene.
# Phase 2 (Ouija): SIM_SCENE=scene_ouija.xml
SIM_SCENE=

# Camera pose (TF world -> camera): sim = ground truth from the simulator,
# calib = estimated by the camera_calib node from the ArUco A4 sheet (as on the real robot).
CAMERA_TF=sim

# -- USE_SIM=false --

# Host serial port of the arm. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# Path to the calibration file (generated by lerobot-calibrate).
# Mounted read-only in the control container at /calibration/arm.json
CALIBRATION_FILE=~/.cache/huggingface/lerobot/calibration/robots/so_follower/my_awesome_follower_arm.json

# Real arm safety. ARM_TORQUE=false: motors limp, /joint_states only (first contact, find the
# rest pose by hand). ARM_MAX_STEP: cap on each command in rad around the present position
# (0 = off); 0.1 for the first tests, so a wrong command cannot throw the arm.
ARM_TORQUE=true
ARM_MAX_STEP=0
# Max joint speed of the brain's motions, rad/s (1.0 in sim; 0.3 for the first real tests).
ARM_MAX_SPEED=1.0

# -- real USB camera (docker compose up -d camera) --
# Host device (ls /dev/video*; v4l2-ctl --list-devices). Size / fps / pixel format of the
# stream (YUYV for most webcams, GREY for a monochrome OV9281), encoding published
# (rgb8, or mono8 for a monochrome camera). Intrinsics: ros2_ws/calibration/camera_info.yaml
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_PIXEL_FORMAT=YUYV
CAMERA_ENCODING=rgb8
